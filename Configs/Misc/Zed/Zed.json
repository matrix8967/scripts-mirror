// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "minimap": {
    "show": "auto"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "proxy": "",
  "redact_private_values": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "sonnet",
        "mode": "acceptEdits"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "cline": {
      "type": "registry"
    }
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "Mononoki Nerd Font",
  "edit_predictions": {
    "allow_data_collection": "no",
    "enabled_in_text_threads": false,
    "provider": "none",
  },
  "restore_on_startup": "launchpad",
  "context_servers": {
    "arch-ops-server": {
      "enabled": false,
      "remote": false,
      "settings": {}
    },
    "mcp-server-linear": {
      "enabled": true,
      "settings": {
        "linear_api_key": "YOUR_LINEAR_ACCESS_TOKEN",
      },
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
    "mcp-server-gitlab": {
      "enabled": true,
      "settings": {
        "gitlab_personal_access_token": "glpat-",
      },
    },
    "mcp-server-mui": {
      "enabled": true,
      "settings": {
        "preferred_theme": "",
        "component_filter": [""],
      },
    },
  },
  "icon_theme": "Material Icon Theme",
  "agent": {
    "enable_feedback": false,
    "sandbox_permissions": {
      "network_hosts": [
        "api.github.com"
      ]
    },
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "ask",
    "enabled": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-sonnet-5",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": "Tokyo Night",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "autoInstallExtensions": {
    "ada": true,
    "alpinejs-snippets": true,
    "ansible": true,
    "arch-mcp": true,
    "asciidoc": true,
    "asn1": true,
    "ass": true,
    "assembly": true,
    "autohotkey": true,
    "awk": true,
    "azure-context-server": true,
    "basher": true,
    "bicep": true,
    "browser-tools-context-server": true,
    "caddyfile": true,
    "cargo-tom": true,
    "catppuccin": true,
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "cfengine": true,
    "chrome-devtools-mcp": true,
    "csharp": true,
    "csharp-snippets": true,
    "csv": true,
    "d2": true,
    "dart": true,
    "defold": true,
    "demotape": true,
    "desktop": true,
    "docker-compose": true,
