    "duckyscript": true,
    "editorconfig": true,
    "env": true,
    "fortran": true,
    "gdscript": true,
    "gdscript-snippets": true,
    "gem": true,
    "ghostty": true,
    "git-firefly": true,
    "github-actions": true,
    "gitlab-ci-ls": true,
    "go-snippets": true,
    "golangci-lint": true,
    "gosum": true,
    "graphql": true,
    "graphviz": true,
    "hql": true,
    "html": true,
