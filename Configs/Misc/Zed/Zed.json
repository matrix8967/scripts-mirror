// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "cline": {
      "type": "registry"
    }
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "Mononoki Nerd Font",
  "edit_predictions": {
    "enabled_in_text_threads": false,
    "provider": "none"
  },
  "restore_on_startup": "launchpad",
  "context_servers": {
    "mcp-server-linear": {
      "enabled": true,
      "settings": {
        "linear_api_key": "YOUR_LINEAR_ACCESS_TOKEN"
      }
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000"
      }
    },
    "mcp-server-gitlab": {
      "enabled": true,
      "settings": {
        "gitlab_personal_access_token": "$GITLAB_TOKEN"
      }
    },
    "mcp-server-mui": {
      "enabled": true,
      "settings": {
        "preferred_theme": "",
        "component_filter": [""]
      }
    }
  },
  "icon_theme": "Material Icon Theme",
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "ask",
    "enabled": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-latest"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": "Tokyo Night",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "autoInstallExtensions": [
    "ada",
    "alpinejs-snippets",
