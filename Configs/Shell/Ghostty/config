## General

undo-timeout = 10s
maximize = true
working-directory = home
confirm-close-surface = false
quit-after-last-window-closed = true
shell-integration = detect
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
window-new-tab-position = end
window-theme = dark
window-padding-balance = true
term = xterm-ghostty
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path
auto-update = check
bell-features = no-system,no-audio,no-attention,no-title,no-border
bell-audio-volume = 0
tab-inherit-working-directory = false
window-inherit-working-directory = false
split-inherit-working-directory = false

## UI

background-opacity = 0.85
background-blur = 20
theme = TokyoNight
bold-is-bright = true
background = #1a1b26
foreground = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #15161e
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
font-family = "Mononoki Nerd Font Mono"

## Shaders

# custom-shader = /home/azazel/.config/ghostty/shaders/crt_02.glsl
# custom-shader-animation = true

## Quick terminal
keybind = global:ctrl+backquote=toggle_quick_terminal

quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

## Keybinds

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+-=new_split:down
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:top
keybind = ctrl+down=goto_split:bottom

## Mouse

mouse-hide-while-typing = true
mouse-shift-capture = true
focus-follows-mouse = true

## Clipboard

clipboard-read = allow
clipboard-write = allow
copy-on-select = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

## GTK

gtk-single-instance = true
gtk-opengl-debug = false
app-notifications = clipboard-copy,config-reload
gtk-wide-tabs = false
gtk-titlebar = true
gtk-titlebar-hide-when-maximized = false
gtk-toolbar-style = flat
